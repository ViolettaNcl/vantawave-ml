VANTAWAVE_ENV=production
VANTAWAVE_HOST=0.0.0.0
VANTAWAVE_PORT=8000
VANTAWAVE_LOG_LEVEL=INFO
VANTAWAVE_LOG_FORMAT=json
VANTAWAVE_READINESS_REQUIRES_DATABASE=true

# Docker Compose PostgreSQL
POSTGRES_DB=vantawave
POSTGRES_USER=vantawave
POSTGRES_PASSWORD=change-me

# Application DB URL for Compose.
VANTAWAVE_DATABASE_URL=postgresql+psycopg://vantawave:change-me@postgres:5432/vantawave

# Multiple paths use the OS path separator.
VANTAWAVE_KNOWLEDGE_PATHS=docs
